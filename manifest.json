{
  "manifest_version": 3,
  "name": "TikTok Video Downloader",
  "version": "1.0.0",
  "author": "Zodi4c",
  "description": "TikTok videolarını filigransız (HD/SD), seslerini MP3, fotoğraf slaytlarını ve GIF'leri tek tıkla indirin. Created by Zodi4c.",
  "permissions": [
    "downloads",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.tiktok.com/*",
    "https://*.tikwm.com/*",
    "https://api.tiklydown.eu.org/*",
    "https://*.tiktokcdn.com/*",
    "https://*.tiktokcdn-us.com/*",
    "https://*.tiktokcdn-eu.com/*",
    "https://*.muscdn.com/*",
    "https://*.ibyteimg.com/*",
    "https://*.byteimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://tiktok.com/*",
        "https://m.tiktok.com/*"
      ],
      "js": ["gif-encoder.js", "zip-builder.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TikTok Video Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
